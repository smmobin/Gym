# Copy to backend/.env and fill in real values (never commit .env)

APP_NAME=GYM CONTROL API

# development | staging | production
# production/staging → cookie Secure=true؛ /docs خاموش؛ seed مسدود مگر ALLOW_DESTRUCTIVE_SEED
APP_ENV=development

API_PREFIX=/api/v1

# Domains that may call the API with credentials (comma-separated, no spaces required)
# Dev:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prod example (replace with your real HTTPS origins):
# CORS_ORIGINS=https://app.example.com,https://www.example.com

# PostgreSQL — SQLAlchemy URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/gym_control

# Long random string (≥32 chars). Required for production checklist.
# Generate e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME

# Seed wipes domain tables — keep false on any DB with real members
ALLOW_DESTRUCTIVE_SEED=false

# Auth (optional overrides)
# SESSION_COOKIE_NAME=gym_session
# SESSION_IDLE_MINUTES=5
# SESSION_TTL_HOURS=12
# ATHLETE_SESSION_COOKIE_NAME=gym_athlete_session
# ATHLETE_SESSION_IDLE_MINUTES=5
# ATHLETE_SESSION_TTL_HOURS=12

# Backup scripts (optional)
# BACKUP_DIR=D:\GymBackups
# PG_DUMP_PATH=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe
# PG_RESTORE_PATH=C:\Program Files\PostgreSQL\17\bin\pg_restore.exe

# Bind host tip (not an env of the app — pass to uvicorn):
# Dev:  uvicorn app.main:app --reload --host 127.0.0.1 --port 8000
# Prod behind reverse proxy: uvicorn app.main:app --host 0.0.0.0 --port 8000

# ── Online payment gateway (Zarinpal) ──
# Leave PROVIDER=none (or empty MERCHANT_ID) → UI shows «آماده نیست»; desk renewal request stays.
# NEVER commit a real merchant id. Sandbox accepts any UUID-like merchant string.
#
# PAYMENT_GATEWAY_PROVIDER=none
# PAYMENT_GATEWAY_PROVIDER=zarinpal
# PAYMENT_GATEWAY_MERCHANT_ID=
# PAYMENT_GATEWAY_SANDBOX=true
# Server callback Zarinpal redirects to (must reach this API; HTTPS in production):
# PAYMENT_GATEWAY_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/gateway/callback
# After verify, browser lands here (optional; defaults to first CORS origin + /athlete/#pay):
# PAYMENT_GATEWAY_FRONT_RETURN_URL=http://127.0.0.1:5173/athlete/#pay

# ── SMS provider (Kavenegar) ──
# Leave PROVIDER=none (or empty API_KEY) → UI shows «هنوز آماده نیست»; send → 403.
# NEVER commit a real API key. Real sends consume panel credit / cost money.
#
# SMS_PROVIDER=none
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=
# SMS_SENDER=

