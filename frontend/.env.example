# Copy to frontend/.env if you need overrides (optional in local dev).
#
# Local development:
#   Leave empty — Vite proxies /api → http://127.0.0.1:8000 (same-origin cookies).
VITE_API_BASE_URL=

# Production options:
#   1) Same-origin behind reverse proxy (recommended): leave empty and proxy /api → API
#   2) Separate API host: set absolute origin, e.g.
#      VITE_API_BASE_URL=https://api.example.com
#      (then CORS_ORIGINS on the API must include the frontend origin; cookies need
#       same-site / shared parent domain care — prefer option 1)
#
# Build:
#   npm run build
# Output: frontend/dist/  → upload to static host or serve via nginx
